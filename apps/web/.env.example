# @estate/web — copy to `.env.local` (single merged Next.js app)
# Shared secrets: copy from repo root `.env` or define here for deployment

NODE_ENV="development"
APP_URL="http://localhost:3000"

# ——— Database ———
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DATABASE_CONNECTION_LIMIT="10"
DATABASE_POOL_TIMEOUT="20"

# ——— Authentication ———
JWT_SECRET="change-me-use-openssl-rand-base64-32"
JWT_EXPIRES_IN="7d"
ADMIN_EMAIL="estate.data@gmail.com"
ADMIN_PASSWORD="change-me-in-production"

# ——— Public client (embedded in bundle) ———
# Optional — omit for same-origin /api/v1 relative requests on :3000
# NEXT_PUBLIC_API_URL="http://localhost:3000"
# false = live same-origin API; true = mock static assets only
NEXT_PUBLIC_USE_MOCK_API="false"
# Google Tag Manager — omit to disable; public container ID (not a secret)
# NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# ——— Email (Resend, contact form) ———
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@yourdomain.com"
CONTACT_NOTIFY_EMAIL="studio@yourdomain.com"

# ——— Cache / rate limit (Upstash Redis) ———
UPSTASH_REDIS_REST_URL="https://YOUR-INSTANCE.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""
CACHE_TTL_SEC="60"
RATE_LIMIT_CONTACT_MAX="10"
RATE_LIMIT_CONTACT_WINDOW_SEC="60"
RATE_LIMIT_ADMIN_MAX="30"
RATE_LIMIT_ADMIN_WINDOW_SEC="60"

# ——— File storage (Cloudflare R2) ———
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL="https://assets.yourdomain.com"

# ——— Payments ———
IDRAM_TEST_MODE="true"
API_PUBLIC_URL="http://localhost:3000"

# ——— Asset fallback (optional) ———
# WEB_PUBLIC_DIR="./public"

# ——— Observability (optional) ———
SENTRY_DSN=""
